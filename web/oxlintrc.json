{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/tc39-proposal-json-schema/refs/heads/main/packages/oxlint/schema.json",
  "plugins": ["react", "react-perf", "typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "nursery": "off",
    "style": "off"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-direct-mutation-state": "error",
    "react/jsx-no-duplicate-props": "error",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off",
    "unicorn/no-null": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "src/components/ui"]
}
