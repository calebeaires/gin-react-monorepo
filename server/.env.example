# ============================================================
# gin-react-monorepo — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required ---

# Secret key for Authula session signing.
# Generate one with: openssl rand -hex 32
AUTHULA_SECRET=change-me-to-a-random-secret

# Neon Postgres connection string.
# Get yours at https://neon.tech → Project → Connection Details
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional ---

# Server port (default: 8081)
# PORT=8081

# Authula base URL — used for auth callbacks.
# In development, this should point to the Go server.
# AUTHULA_BASE_URL=http://localhost:8081
